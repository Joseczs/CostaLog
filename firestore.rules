rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════
// COSTACON — Reglas de seguridad Firestore
// Bloque 2   — Dos roles.  (D-03, D-04)
// Bloque 5b  — Alcance por maestro: `supervisorIds` en el proyecto.
// Bloque 5c  — El rol de campo se llama 'maestro'.  Fase A: se aceptaban
//              los dos valores.  FASE D (esta): solo 'maestro'.
//
//   ingeniero ≡ Ingeniero Residente.  Define el alcance y las reglas:
//               proyectos, reglasBono, metas, hitos, evaluaciones, pagos,
//               creación de tareas BP y de empleados.  APRUEBA el avance.
//
//   maestro   ≡ Maestro de Obras.  Ejecuta en sitio: arma cuadrillas,
//               reporta HH reales, alterna `disponible` de su roster,
//               cierra la asistencia del día.  PROPONE el avance, no lo
//               aprueba.
//
// UN NOMBRE POR ROL.  'supervisor', 'jefe_cuadrilla' y 'admin' no conceden
// nada.  El campo `supervisorIds` del proyecto conserva su nombre porque
// renombrarlo es migración de datos, no de reglas.
//
// Los roles 'jefe_cuadrilla' y 'admin' fueron eliminados (ver
// scripts/migrar-roles.js).  Ningún valor fuera de los dos de arriba
// concede permiso alguno.
//
// BORRADO DURO: prohibido en toda la base.  El histórico de bonos cuelga
// del soft-delete (`activo: false`).  `deleteDoc` no se invoca en la app.
// ═══════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────

    function autenticado() {
      return request.auth != null;
    }

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // `activo` ausente cuenta como activo — misma invariante que los repos.
    function habilitado() {
      return autenticado() && perfil().activo != false;
    }

    function esIngeniero() {
      return habilitado() && perfil().rol == 'ingeniero';
    }

    // ── FASE D del bloque 5c — la tolerancia se retira ─────────────────
    //
    // La fase A aceptaba 'maestro' Y 'supervisor' para que datos, reglas y
    // código no tuvieran que cambiar en el mismo instante. Migrados todos
    // los documentos (fase B) y cerrado el grifo que seguía escribiendo el
    // valor viejo desde el registro (5c/C-bis), la tolerancia ya no
    // protege a nadie: solo deja viva una puerta que nadie vigila.
    //
    // El alias de compatibilidad de la fase A —que se llamaba como el rol
    // viejo— queda RETIRADO. Un alias que no hace nada es un renglón que
    // el próximo lector interpreta como que sí hace algo.
    //
    // ⚠️ Si esta función volviera a aceptar 'supervisor', el bloque 5c
    // quedó a medias — o alguien restauró un archivo viejo.
    function esMaestro() {
      return habilitado() && perfil().rol == 'maestro';
    }

    // Cualquiera de los dos roles válidos. Un rol desconocido da false.
    function esUsuario() {
      return esIngeniero() || esMaestro();
    }

    function esElMismoUsuario(uid) {
      return autenticado() && request.auth.uid == uid;
    }

    // La escritura toca únicamente los campos listados y ninguno más.
    function soloCambia(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // Espejo del anterior: la escritura NO toca ninguno de estos campos,
    // haga lo que haga con el resto. Bloque 5d.
    function noToca(campos) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(campos);
    }

    // ── Bloque 5d — con qué rol nace una cuenta ────────────────────────
    //
    // El campo tiene que estar presente Y valer 'maestro'. Un documento
    // sin `rol` obligaría a cada guardia a manejar un tercer estado que
    // hoy no existe; mismo criterio que `rutaHomePorRol` y `renderSidebar`
    // en el código: ante ambigüedad se degrada al rol de MENOS alcance.
    //
    // ⚠️ ESPEJO DE `ROLES_REGISTRO` en public/js/roles.js. Si las dos
    // dejaran de coincidir, el formulario ofrecería un rol que esta regla
    // rechaza. Se cambian juntas o no se cambia ninguna.
    //
    // El literal vive acá adentro y no suelto en el `allow`, igual que los
    // dos de `esIngeniero()` y `esMaestro()`. Es una comparación distinta
    // de aquellas: no lee quién sos (`perfil().rol`), lee qué estás
    // escribiendo (`request.resource.data.rol`).
    function naceComoMaestro() {
      return 'rol' in request.resource.data
             && request.resource.data.rol == 'maestro';
    }

    // ── Alcance por supervisor (bloque 5b) ──────────────────────────────
    //
    // La asimetría es deliberada: el ingeniero ve TODO —define el alcance
    // de todos los frentes—; el supervisor ve solo donde está asignado.
    // No es una regla de privacidad simétrica: es que el bono de otro
    // Maestro de Obras no es asunto suyo.

    // La comprobación de la clave va PRIMERO y es deliberada. Un proyecto
    // sin el campo hace que `in` lance error, y una regla que lanza error
    // deniega — el resultado correcto, pero por accidente. Así queda
    // explícito: campo ausente ⇒ no lo ve ningún supervisor.
    //
    // FAIL-CLOSED, y es una divergencia consciente con "activo por
    // omisión": ese criterio existe para que una migración no esconda
    // media base. Acá el riesgo es el contrario — un campo ausente que da
    // acceso a plata ajena. Un supervisor que no ve un proyecto se queja
    // el mismo día; uno que ve el bono de otro no se queja nunca.
    function estaEnLaLista(datos) {
      return 'supervisorIds' in datos.keys()
             && request.auth.uid in datos.supervisorIds;
    }

    // Para el documento del proyecto, donde `resource` YA es el proyecto.
    // Cubre `get` y `list`. Para `list`, Firestore evalúa la CONSULTA y no
    // sus resultados: si un solo documento no pasara, falla entera. Por eso
    // el cliente filtra con `where('supervisorIds','array-contains', uid)`
    // — no es cosmético, es lo que hace la consulta demostrablemente segura.
    function puedeVerEsteProyecto() {
      return esIngeniero() || (esMaestro() && estaEnLaLista(resource.data));
    }

    // Para las subcolecciones, donde hay que ir a buscar el padre.
    //
    // El `get()` cuesta una lectura facturada. Ese es el precio de que la
    // protección sea real y no de interfaz: sin esto, un supervisor con la
    // URL de una meta ajena leería su bono igual. Firestore cachea el mismo
    // `get()` dentro de una solicitud, así que leer 52 hitos no son 52
    // lecturas extra.
    function puedeVerProyecto(proyectoId) {
      return esIngeniero()
             || (esMaestro()
                 && estaEnLaLista(
                      get(/databases/$(database)/documents/proyectos/$(proyectoId)).data));
    }

    // ── /usuarios/{uid} ─────────────────────────────────────────────────
    // Lectura abierta a usuarios autenticados: el Ingeniero necesita
    // listar supervisores para asignarles tareas.
    //
    // ── BLOQUE 5d — la deuda 1 queda CERRADA ───────────────────────────
    //
    // Antes: `create` no miraba el campo `rol` y `update` dejaba al propio
    // usuario reescribir su documento entero. Cualquier cuenta autenticada
    // podía crearse —o ascenderse— a 'ingeniero' desde la consola del
    // navegador y quedar habilitada para aprobar su propio % de avance y
    // cerrar metas. Mientras eso estuvo abierto, el contrapeso de D-11 fue
    // de interfaz y no de seguridad.
    //
    // Son DOS agujeros, no uno. Cerrar solo el `create` habría dejado el
    // otro abierto con una regla nueva encima dando la impresión de que se
    // cerró — peor que la deuda declarada.
    //
    // `activo` va junto a `rol` a propósito: `habilitado()` lo mira. Si el
    // Ingeniero desactiva una cuenta y su dueño puede reescribir
    // `activo: true`, la desactivación es decorativa. Mismo agujero, misma
    // línea.
    //
    // Hoy NINGUNA pantalla hace `update` sobre este documento —el único
    // escritor es el registro, en auth.js—. La rama del propio usuario se
    // deja escrita igual, con la exclusión puesta: el día que aparezca
    // "editar mi perfil", quien la use hereda la protección en vez de
    // tener que acordarse de ella. Que es exactamente como nació la deuda.
    //
    // Promover a 'ingeniero' es un `update` de otro ingeniero. No hay
    // pantalla: es consola o script (deuda 23). En una instalación NUEVA,
    // sin ningún ingeniero, nadie puede llegar a serlo desde la app — el
    // primero se crea con el SDK admin, que no pasa por reglas.
    match /usuarios/{uid} {
      allow read:   if autenticado();
      allow create: if esElMismoUsuario(uid) && naceComoMaestro();
      allow update: if esIngeniero()
                       || (esElMismoUsuario(uid) && noToca(['rol', 'activo']));
      allow delete: if false;

      // ── /usuarios/{supervisorUid}/empleados/{empleadoId} ─────────────
      // Roster de operarios y ayudantes de un supervisor. NO son usuarios
      // del sistema: nunca se autentican, solo reciben su parte del BP.
      //
      // `activo`     — control maestro del Ingeniero (alta / soft-delete).
      // `disponible` — asistencia del día, la marca el propio supervisor.
      // Son campos distintos y los escriben roles distintos.
      match /empleados/{empleadoId} {
        allow read:   if esUsuario();
        allow create: if esIngeniero();
        allow update: if esIngeniero() ||
                         (esElMismoUsuario(uid) && esMaestro() &&
                          soloCambia(['disponible']));
        allow delete: if false;
      }
    }

    // ── /proyectos/{proyectoId} ─────────────────────────────────────────
    // Incluye el mapa `reglasBono`: editarlo es `update` sobre el proyecto,
    // por lo tanto exclusivo del Ingeniero.
    //
    // Bloque 5b: la matriz §6 —"el supervisor ve solo los suyos"— por fin
    // se aplica. El campo es `supervisorIds: string[]`; arreglo en las dos
    // direcciones, porque un supervisor puede tener varios frentes (§6.2)
    // y nada impide que un frente tenga dos supervisores.
    match /proyectos/{proyectoId} {
      allow read:           if puedeVerEsteProyecto();
      allow create, update: if esIngeniero();
      allow delete:         if false;

      // ── metas ────────────────────────────────────────────────────────
      // hhPlanilla, fechaEntrega, cierre y snapshot: todos del Ingeniero.
      match /metas/{metaId} {
        allow read:           if puedeVerProyecto(proyectoId);
        allow create, update: if esIngeniero();
        allow delete:         if false;

        // ── hitos ──────────────────────────────────────────────────────
        // D-11 aplicado en el servidor: el supervisor solo puede escribir
        // la propuesta. `avancePct` — el valor que el motor usa para
        // calcular dinero — es inaccesible para quien cobra el bonoMO.
        // Las dos condiciones se SUMAN desde el bloque 5b: solo la
        // propuesta, y solo en los proyectos que son suyos.
        match /hitos/{hitoId} {
          allow read:   if puedeVerProyecto(proyectoId);
          allow create: if esIngeniero();
          allow update: if esIngeniero() ||
                           (esMaestro() &&
                            puedeVerProyecto(proyectoId) &&
                            soloCambia(['avancePropuesto', 'propuestoPor', 'propuestoEn']));
          allow delete: if false;
        }

        // ── evaluaciones (ornato / SO) ─────────────────────────────────
        // El factor de calidad es el freno del sistema y lo califica quien
        // no cobra el bono que ese factor reduce.
        match /evaluaciones/{evaluacionId} {
          allow read:           if puedeVerProyecto(proyectoId);
          allow create, update: if esIngeniero();
          allow delete:         if false;
        }

        // ── asistencias (D-12) ─────────────────────────────────────────
        // Anticipado para el bloque 7b: sin consumidores todavía. Se deja
        // escrito para no repetir el deploy de reglas más adelante.
        // El supervisor cierra el día; el ingeniero puede corregirlo.
        match /asistencias/{fecha} {
          allow read:           if puedeVerProyecto(proyectoId);
          allow create, update: if esIngeniero() ||
                                   (esMaestro() && puedeVerProyecto(proyectoId));
          allow delete:         if false;
        }
      }

      // ── tareas (Bono por Productividad) ────────────────────────────────
      // El campo `jefeCuadrillaId` conserva su nombre a propósito:
      // renombrarlo es una migración de datos que pertenece al bloque 7.
      // Aquí guarda el uid del SUPERVISOR asignado.
      match /tareas/{tareaId} {
        allow read:   if puedeVerProyecto(proyectoId);
        allow create: if esIngeniero();
        allow update: if esIngeniero() ||
                         (esMaestro() &&
                          puedeVerProyecto(proyectoId) &&
                          resource.data.jefeCuadrillaId == request.auth.uid);
        allow delete: if false;

        // ── registrosHoras/{empleadoId} ──────────────────────────────────
        // Ata el reverso del ticket al frente: solo el supervisor asignado
        // a ESTA tarea escribe sus horas.
        match /registrosHoras/{empleadoId} {
          allow read:  if puedeVerProyecto(proyectoId);
          allow write: if esIngeniero() ||
                          (esMaestro() &&
                           puedeVerProyecto(proyectoId) &&
                           get(/databases/$(database)/documents/proyectos/$(proyectoId)/tareas/$(tareaId))
                             .data.jefeCuadrillaId == request.auth.uid);
        }
      }

      // ── pagos (bloque 8) ───────────────────────────────────────────────
      // Anticipado, sin consumidores todavía.
      //
      // ⚠️ CAMBIO DEL BLOQUE 5b: la lectura pasa de `esUsuario()` a
      // `esIngeniero()`. El libro incluye `montoIngeniero` y
      // `montoTrabajadores`: es el reparto completo de la obra, no el bono
      // propio. Ver su propio bono es la pantalla del bloque 5; esto es
      // otra cosa. Se hace AHORA porque no hay consumidores — abrirlo
      // después es fácil; cerrarlo cuando alguien ya lo lee, no.
      // Vuelta atrás, si se decide lo contrario, es una línea:
      //     allow read: if puedeVerProyecto(proyectoId);
      match /pagos/{pagoId} {
        allow read:           if esIngeniero();
        allow create, update: if esIngeniero();
        allow delete:         if false;
      }
    }
  }
}
